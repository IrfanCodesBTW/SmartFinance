# SmartFinance Environment Variables Example
# Copy this file to .env and fill in your actual API keys

# API Key for Groq (optional, if AI features are implemented)
GROQ_API_KEY=your_groq_api_key_here

# API Key for Google Gemini (optional, if AI features are implemented)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3000
