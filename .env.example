# SmartFinance Environment Variables Example
# Copy this file to .env and fill in your actual values

# =====================
# Valkey Cache Configuration
# =====================
# Connection string for Valkey/Redis server
# Default: redis://127.0.0.1:6379 (local development)
VALKEY_URL=redis://127.0.0.1:6379
# Railway uses REDIS_URL by default for its Redis/Valkey plugin
REDIS_URL=redis://127.0.0.1:6379


# Optional: Secret for cache flush endpoint (production only)
# Set this to a random string in production and pass it via X-Cache-Flush-Secret header
# CACHE_FLUSH_SECRET=your-random-secret-here

# =====================
# AI API Keys
# =====================
# Get your Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =====================
# Server Configuration
# =====================
# Port for the Express server
PORT=3000

# Node environment (development, production, test)
NODE_ENV=development